<?xml version="1.0" encoding="UTF-8"?>
<!--
  HAI913I - TP1 Analyse statique - squelette de depart (2026-2027).

  Versions epinglees et testees : JDK 17 (minimum) et 21, Maven 3.9.6,
  Eclipse JDT Core 3.46.0, JUnit Jupiter 5.14.4.

    mvn clean test       compile et execute le test de fumee (point de controle A0)
    mvn clean package    produit target/hai913i-tp1-analyzer.jar (executable)
    java -jar target/hai913i-tp1-analyzer.jar CHEMIN_DU_PROJET
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.umontpellier.hai913i</groupId>
    <artifactId>hai913i-tp1-analyzer</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jdt.version>3.46.0</jdt.version>
        <junit.version>5.14.4</junit.version>
        <spoon.version>11.5.0</spoon.version>
        <slf4j.version>2.0.18</slf4j.version>
    </properties>

    <dependencies>
        <!-- Une seule dependance suffit : Maven telecharge les bibliotheques Eclipse necessaires. -->
        <dependency>
            <groupId>org.eclipse.jdt</groupId>
            <artifactId>org.eclipse.jdt.core</artifactId>
            <version>${jdt.version}</version>
        </dependency>
        <!-- Partie C1 (bonus) : seconde extraction, avec Spoon. Spoon 11.5.0 s'appuie sur JDT Core 3.46.0,
             la version deja declaree ci-dessus : une seule version de JDT sur le classpath. -->
        <dependency>
            <groupId>fr.inria.gforge.spoon</groupId>
            <artifactId>spoon-core</artifactId>
            <version>${spoon.version}</version>
        </dependency>
        <!-- Sans implementation SLF4J, Spoon affiche un avertissement au demarrage. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>hai913i-tp1-analyzer</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <!-- Produit un JAR executable contenant aussi les dependances. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>hai913i.tp1.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <!-- Les JAR Eclipse sont signes : sans ce filtre, le JAR fusionne est refuse
                                         au lancement (SecurityException: Invalid signature file digest). -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
